# Optional overrides — mspbots-forms-mcp has no required env vars.
# Authentication is per-request via two headers:
#   X-MSP-Token   Agent Platform access credential (JWT bearer token, already
#                 issued to the caller). Forwarded verbatim as
#                 "Authorization: Bearer <token>" to the Forms/Survey API.
#                 Tenant isolation is derived server-side from this token
#                 (per the API contract) — no separate tenant header is sent.
#   X-MSP-Host    Base host for the Forms/Survey API, e.g.
#                 https://forms.mspbots.ai — this server appends
#                 "/api/<endpoint>" to it.

MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0
